<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aaron.pilot-stale-pr-audit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aaron/development/pilot/scripts/stale-pr-audit.sh</string>
        <string>--notify</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <!-- Sunday 08:15 — right after the Health Report (08:00), and ~14h
             before Sunday's Discovery (22:00), so anything it flags can be
             closed or landed before the next build cycle picks work up. -->
        <dict>
            <key>Weekday</key>
            <integer>0</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/aaron/Documents/Claude/outputs/pilot-stale-pr-audit-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aaron/Documents/Claude/outputs/pilot-stale-pr-audit-launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Users/aaron/.npm-global/bin</string>
        <key>HOME</key>
        <string>/Users/aaron</string>
    </dict>
</dict>
</plist>
