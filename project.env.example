# Pilot — Project Configuration
# Copy this file to project.env and fill in your values.
# This file is sourced by all pipeline scripts.
# Generate automatically with: ./init.sh

# ── Project ──────────────────────────────────────────────────
PROJECT_NAME="<your-project>"                    # Short name, used in filenames and logs
PROJECT_DESC="<brief description for AI prompts>"
TECH_STACK="<e.g., Vue 3 + TypeScript PWA>"
REPO_PATH="/Users/you/development/<your-project>"
GITHUB_REPO="<username>/<your-project>"
DEFAULT_BRANCH="main"                            # main or master

# ── Issue Tracker ────────────────────────────────────────────
TRACKER_ADAPTER="linear"                         # linear | github | custom
GITHUB_ISSUES_REPO="<username>/<your-project>"   # Repo whose Issues/PRs the pipeline manages (github backend; usually same as GITHUB_REPO)
ISSUE_PREFIX="<PREFIX>"                          # Issue ID prefix used in logs/markers (e.g., LIFT, MAS). For Linear this is usually the team key; for GitHub it's a custom label.
GH_OPEN_LIMIT="1000"                             # Row cap for tracker.sh's open-issue queries (GitHub backend).
                                                 #   `gh issue list` truncates SILENTLY, so a cap below your real
                                                 #   open-issue count hides issues from the builder's picking pool
                                                 #   and from triage. Keep it comfortably above that count;
                                                 #   tracker.sh warns on stderr if a query returns at the cap.
# LINEAR_* vars are only needed when using the Linear backend (TRACKER_ADAPTER=linear)
LINEAR_TEAM="<TEAM>"                             # Linear team key (e.g., MAS, ENG)
LINEAR_PROJECT="<your-project>"                  # Linear project name
LINEAR_ORG="<your-org>"                          # Linear org slug (from your URL)

# ── AI Models ────────────────────────────────────────────────
AI_CODE_MODEL="claude-opus-5[1m]"              # Opus-tier model for builder/discovery/code-gen (and the
                                                 #   architect's fallback). Pin a full version (e.g.
                                                 #   claude-opus-5[1m]) for the 1M-context variant; the
                                                 #   bare 'opus' alias can't request 1M.
AI_CODE_EFFORT="max"                             # Reasoning effort for Opus calls: low|medium|high|max
AI_ARCHITECT_MODEL="claude-fable-5"              # Architect only: weekly deep whole-codebase review runs
                                                 #   the top tier (low cadence bounds the 2x price). Unset
                                                 #   to inherit AI_CODE_MODEL. Fable's context is 1M by
                                                 #   default — no [1m] suffix.
AI_RESEARCH_MODEL="gemini-2.5-flash"             # Web research (discovery) + triage, via the Gemini REST API.
                                                 #   Free-tier Flash only (Pro is billed). Auth uses GEMINI_API_KEY
                                                 #   from ~/.zshenv — NOT the retired 'gemini' OAuth CLI.
AI_RESEARCH_TIMEOUT="120"                        # Per-call wall-clock cap (seconds) for the Gemini API request.

# ── Agent Tuning ─────────────────────────────────────────────
# Per-agent turn caps (cost / performance). Higher = agent can do more per call
# (more cost); lower bounds it. All have safe built-in fallbacks if unset.
BUILDER_MAX_TURNS=100                             # Main implementation call
BUILDER_FIX_MAX_TURNS=30                          # Merge-conflict + CI-fix retries
BUILDER_PREPICK_MAX_TURNS=2                       # Cheap issue-selection stage
DISCOVER_MAX_TURNS=30                             # Discovery analysis + issue creation
ARCHITECT_MAX_TURNS=40                            # Weekly architecture analysis
TRIAGE_MAX_TURNS=6                                # Per-issue triage (3 was too low — Sonnet got cut off)
ROADMAP_MAX_TURNS=3                               # Roadmap synthesis

# Builder resilience (behavior). How persistent the overnight loop is before giving up.
MAX_CONSECUTIVE_FAILURES=3                        # Stop after N Claude failures in a row
MAX_STALLS=2                                      # Stop after N iterations producing no commits
MAX_FIX_ATTEMPTS=1                                # CI-fix tries per iteration

# ── Flow / Backlog Policies (agile: WIP limit, backlog expiry, release burndown) ──
MAX_OPEN_PRS=8                                    # WIP limit: builder stops for the night when this many
                                                  #   PRs are already open awaiting review (0 disables).
                                                  #   Retry iterations for ci:failed PRs are exempt.
BACKLOG_EXPIRY_DAYS=56                            # cleanup.sh auto-closes priority:4-low issues untouched
                                                  #   this long (not planned; reopen if relevant). 0 disables.
GA_MILESTONE="GA"                                 # GitHub milestone the weekly health report tracks as the
                                                  #   release burndown (create it and tag GA-blocking issues).

# Builder claude-call wall-clock timeouts (seconds). Kills a hung call's process
# tree so one stuck call can't silently block the launchd builder (2026-07-09: a
# hung call took it offline 5 days). Generous by design; set 0 to disable.
BUILDER_ITERATION_TIMEOUT=3600                    # Main implement+review+push call
BUILDER_FIX_TIMEOUT=1800                          # CI-fix / merge-conflict retry calls
BUILDER_PREPICK_TIMEOUT=300                       # Cheap issue pre-pick call
BUILDER_AUTH_TIMEOUT=180                          # Auth preflight probe

# Reasoning effort for the Sonnet planning agents (creativity / quality).
AI_TRIAGE_EFFORT="high"                           # low|medium|high|max (Opus effort = AI_CODE_EFFORT)
AI_ROADMAP_EFFORT="high"

# ── Budget / Rate Limits (config/budget.conf) ────────────────
# Nightly cost/rate knobs live in config/budget.conf (auto-tuned by tune-budget.sh).
# Documented here for discoverability; edit budget.conf to change them:
#   MAX_ITERATIONS_PER_NIGHT=12        # hard cap on builder loop
#   MAX_OUTPUT_TOKENS_PER_NIGHT=500000 # stop builder if cumulative output exceeds this
#   ITERATION_COOLDOWN=30              # seconds between iterations (rate-limit smoothing)
#   ALERT_THRESHOLD_PCT=80             # Slack alert when usage exceeds this % of cap
#   DEFAULT_STOP_TIME=07:00            # builder stops at this time (CLI arg overrides)

# ── Code Review ──────────────────────────────────────────────
# Not configured here. Adversarial review runs inline as a PostToolUse hook via
# ~/.claude/scripts/review-router.sh (headless `claude -p`, Sonnet by default).
# Override the model with PILOT_REVIEW_MODEL in ~/.zshenv.
# The AI_REVIEW_MODEL_L* / _FALLBACK_L* / _TIMEOUT_L* vars were removed
# 2026-07-17 along with the dead adapters/ai-review.sh — nothing reads them.

# ── Auth (headless `claude` for all agents) ──────────────────
# All agents call the `claude` CLI. Under launchd there's no interactive
# session to refresh a keychain OAuth login, so set a long-lived token in
# ~/.zshenv (sourced by every pilot script) instead of relying on the keychain:
#   CLAUDE_CODE_OAUTH_TOKEN   # from `claude setup-token`; persisted via
#                             # ~/Documents/Scripts/set-claude-token.sh
# Never commit this — it lives in ~/.zshenv, not here. See docs Builder Auth.

# ── Notifications ────────────────────────────────────────────
# Webhook URLs and bot tokens go in ~/.zshenv (never commit secrets)
SLACK_CHANNEL_AUTOMATION=""                      # Channel ID for build notifications
SLACK_CHANNEL_REVIEW=""                          # Channel ID for daily review digest
SLACK_CHANNEL_CHANGELOG=""                       # Channel ID for #pilot channel

# ── Paths ────────────────────────────────────────────────────
PILOT_DIR=""                                     # Root of this repo (set by init.sh)
OUTPUT_DIR=""                                    # Runtime data dir (default: $PILOT_DIR/data)
PRODUCT_DECISIONS_FILE=""                        # Optional: path to product decisions doc
OBSIDIAN_VAULT=""                                # Optional: vault root (default: ~/Documents/Obsidian Vault).
                                                 #   roadmap-synth.sh writes its themes here.
AUDITOR_USE_AI_SYNTHESIS="1"                     # pipeline-auditor.sh: 1 = AI synthesis pass, 0 = metrics only
GEMINI_API_BASE=""                               # Optional: override the Gemini REST endpoint used by
                                                 #   adapters/ai-research.sh (default: generativelanguage.googleapis.com/v1beta)
PRODUCT_FEATURES_FILE=""                         # Optional: path to product features doc
